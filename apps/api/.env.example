# Copy to .env and change the secrets.

NODE_ENV=development
PORT=4600

# MySQL 8 installed on the PC (Workbench), port 3306. Create the empty databases first:
#   CREATE DATABASE erpforsell_v2 CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;  (and erpforsell_v2_shadow the same way)
# Using docker instead (pnpm db:up)? Use mysql://bht:bht_dev_password@localhost:3307/bhterp
DATABASE_URL="mysql://root:your_password@localhost:3306/erpforsell_v2"
SHADOW_DATABASE_URL="mysql://root:your_password@localhost:3306/erpforsell_v2_shadow"

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
# Locks the 2-step login secrets in the database (generate it the same way). Optional but recommended:
# set it ONCE before anyone turns on 2-step login and never change it (changing it makes everyone set up 2-step login again).
# Without it a key is made from JWT_ACCESS_SECRET, so then JWT_ACCESS_SECRET must not change either.
# TWO_FACTOR_KEY=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# The web app origin (used for CORS when the API is called directly)
WEB_ORIGIN=http://localhost:3600

# Where uploaded files (drawings, MTC, reports) are stored
STORAGE_DIR=./storage
MAX_UPLOAD_MB=15

# First admin user created by the seed (change the password after first login)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin@12345

# Legacy import: database holding the old phpMyAdmin dump
# LEGACY_DATABASE_URL="mysql://root:your_password@localhost:3306/bht_legacy"

# Outgoing e-mail (purchase orders to suppliers ...).
# Development: Mailpit from docker-compose catches everything at http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="DEMO LTD <no-reply@example.com>"
