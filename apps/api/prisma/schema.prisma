// =============================================================================
//  Manufacturing ERP - database schema
//
//  Rules followed in every table:
//    * snake_case table / column names, utf8mb4_unicode_ci everywhere
//    * real foreign keys (ON DELETE RESTRICT unless the child is owned)
//    * created_at / updated_at, created_by_id where a person creates the record
//    * documents numbered by the DocumentSeries table (SO/26-27/0001 ...)
//    * quantities Decimal(14,3), money Decimal(14,2)
//    * every stock movement goes through stock_ledger (never edit balances by hand)
// =============================================================================

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

// =============================================================================
//  SYSTEM: users, roles, sessions, audit, settings
// =============================================================================

model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique @db.VarChar(50)
  name         String    @db.VarChar(100)
  email        String?   @db.VarChar(150)
  phone        String?   @db.VarChar(20)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  roleId       Int       @map("role_id")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  lastSeenAt   DateTime? @map("last_seen_at")
  /// Own settings: theme, font, accent colour, text size, start page, menu, avatar style (Settings screen).
  preferences  Json?
  /// Profile photo as a small data URL (192 px JPEG), or null.
  avatar       String?   @db.MediumText
  /// Wrong passwords / codes in a row; 5 locks the account for 15 minutes.
  failedLogins       Int       @default(0) @map("failed_logins")
  lockedUntil        DateTime? @map("locked_until")
  /// An admin set the password: the user must choose their own at the next sign-in.
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  passwordChangedAt  DateTime? @map("password_changed_at")
  /// 2-step login: the authenticator secret (encrypted); turned on when twoFactorEnabledAt is set.
  twoFactorSecret    String?   @map("two_factor_secret") @db.VarChar(255)
  twoFactorEnabledAt DateTime? @map("two_factor_enabled_at")
  /// SHA-256 hashes of the unused backup codes.
  twoFactorRecovery  Json?     @map("two_factor_recovery")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  role              Role                  @relation(fields: [roleId], references: [id])
  sessions          Session[]
  auditLogs         AuditLog[]
  notifications     Notification[]
  sentNotifications Notification[]        @relation("NotificationSender")
  chatsCreated      ChatConversation[]    @relation("ChatCreatedBy")
  chatMemberships   ChatMember[]
  chatMessages      ChatMessage[]
  approvals         SalesOrderApproval[]
  materialIssues    MaterialIssue[]
  operationsUpdated RouteCardOperation[]
  salesOrders       SalesOrder[]          @relation("SalesPerson")
  routeCards        RouteCard[]           @relation("RouteCardCreatedBy")
  materialRequests  MaterialRequisition[] @relation("MaterialRequestedBy")
  completionsMoved  RcCompletion[]
  jobWorkOrders     JobWorkOrder[]        @relation("JobWorkCreatedBy")
  jobWorkReceipts   JobWorkReceipt[]      @relation("JobWorkReceivedBy")
  assemblies        Assembly[]            @relation("AssemblyCreatedBy")
  invoices          Invoice[]             @relation("InvoiceCreatedBy")
  dispatches        Dispatch[]            @relation("DispatchCreatedBy")
  payments          Payment[]             @relation("PaymentCreatedBy")

  @@index([roleId])
  @@map("users")
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(50)
  description String?  @db.VarChar(255)
  /// System roles (Admin) cannot be deleted or renamed.
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users         User[]
  permissions   RolePermission[]
  processStages ProcessStageRole[]

  @@map("roles")
}

model RolePermission {
  roleId     Int    @map("role_id")
  /// "<module>.<action>" from packages/shared/src/permissions.ts, or "*"
  permission String @db.VarChar(100)

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permission])
  @@map("role_permissions")
}

/// Refresh-token sessions. The token itself is never stored, only its SHA-256 hash.
model Session {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  userAgent String?   @map("user_agent") @db.VarChar(255)
  ip        String?   @db.VarChar(45)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGIN_FAILED
  LOGOUT
  STATUS_CHANGE
  PASSWORD_CHANGE
}

model AuditLog {
  id        Int         @id @default(autoincrement())
  userId    Int?        @map("user_id")
  action    AuditAction
  entity    String      @db.VarChar(50)
  entityId  String?     @map("entity_id") @db.VarChar(50)
  summary   String?     @db.VarChar(255)
  /// { field: [old, new] } for updates, full record for create/delete
  changes   Json?
  ip        String?     @db.VarChar(45)
  createdAt DateTime    @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Bell notifications: made by the ERP when work reaches someone (kind = TASK), or sent by a user (kind = NOTICE).
model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  kind      String    @default("TASK") @db.VarChar(20)
  title     String    @db.VarChar(150)
  body      String?   @db.VarChar(500)
  link      String?   @db.VarChar(255)
  senderId  Int?      @map("sender_id")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user   User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender User? @relation("NotificationSender", fields: [senderId], references: [id], onDelete: SetNull)

  @@index([userId, readAt])
  @@index([userId, id])
  @@index([senderId])
  @@map("notifications")
}

enum ChatType {
  DIRECT
  GROUP
}

/// A chat between two users (DIRECT) or a named group.
model ChatConversation {
  id            Int       @id @default(autoincrement())
  type          ChatType
  name          String?   @db.VarChar(100)
  /// "smallerUserId:largerUserId" for DIRECT chats, so two people have one chat only.
  directKey     String?   @unique @map("direct_key") @db.VarChar(30)
  createdById   Int?      @map("created_by_id")
  lastMessageAt DateTime? @map("last_message_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  createdBy User?         @relation("ChatCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  members   ChatMember[]
  messages  ChatMessage[]

  @@index([createdById])
  @@index([lastMessageAt])
  @@map("chat_conversations")
}

model ChatMember {
  id                Int       @id @default(autoincrement())
  conversationId    Int       @map("conversation_id")
  userId            Int       @map("user_id")
  /// Group admins can rename the group and add / remove people.
  isAdmin           Boolean   @default(false) @map("is_admin")
  lastReadMessageId Int?      @map("last_read_message_id")
  joinedAt          DateTime  @default(now()) @map("joined_at")
  /// Set when the user leaves / is removed from a group; the history stays.
  leftAt            DateTime? @map("left_at")

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("chat_members")
}

model ChatMessage {
  id             Int       @id @default(autoincrement())
  conversationId Int       @map("conversation_id")
  /// Null for messages written by the ERP ("Kiran added Vijay").
  senderId       Int?      @map("sender_id")
  body           String    @db.Text
  createdAt      DateTime  @default(now()) @map("created_at")
  deletedAt      DateTime? @map("deleted_at")

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?            @relation(fields: [senderId], references: [id], onDelete: SetNull)

  @@index([conversationId, id])
  @@index([senderId])
  @@map("chat_messages")
}

/// Your own legal entities (e.g. DEMO LTD). POs and invoices are issued in the name of one of them.
/// Purchase orders and invoices are issued in the name of one of them.
model Company {
  id            Int      @id @default(autoincrement())
  code          String   @unique @db.VarChar(20)
  name          String   @db.VarChar(200)
  legalName     String?  @map("legal_name") @db.VarChar(200)
  address       String?  @db.VarChar(500)
  city          String?  @db.VarChar(100)
  stateCode     String?  @map("state_code") @db.Char(2)
  pincode       String?  @db.VarChar(10)
  country       String   @default("India") @db.VarChar(60)
  phone         String?  @db.VarChar(50)
  email         String?  @db.VarChar(150)
  website       String?  @db.VarChar(200)
  gstin         String?  @db.VarChar(15)
  pan           String?  @db.VarChar(10)
  iecCode       String?  @map("iec_code") @db.VarChar(20)
  bankName      String?  @map("bank_name") @db.VarChar(100)
  bankAccountNo String?  @map("bank_account_no") @db.VarChar(30)
  bankIfsc      String?  @map("bank_ifsc") @db.VarChar(15)
  bankBranch    String?  @map("bank_branch") @db.VarChar(100)
  swiftCode     String?  @map("swift_code") @db.VarChar(15)
  invoiceTerms  String?  @map("invoice_terms") @db.Text
  purchaseTerms String?  @map("purchase_terms") @db.Text
  /// Pre-selected on new purchase orders and invoices.
  isDefault     Boolean  @default(false) @map("is_default")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  purchaseOrders PurchaseOrder[]
  invoices       Invoice[]

  @@map("companies")
}

/// Generic key/value settings (e.g. payroll.month_days = 26).
model AppSetting {
  key       String   @id @db.VarChar(100)
  value     String   @db.VarChar(1000)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

enum ResetPeriod {
  NEVER
  FINANCIAL_YEAR
  MONTHLY
}

/// Number format for each document type, e.g. SALES_ORDER -> "SO/{FY}/{SEQ:4}".
model DocumentSeries {
  code        String      @id @db.VarChar(40)
  name        String      @db.VarChar(100)
  template    String      @db.VarChar(60)
  resetPeriod ResetPeriod @default(FINANCIAL_YEAR) @map("reset_period")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  counters DocumentCounter[]

  @@map("document_series")
}

/// Running counter per series and period: "ALL", "FY2627" or "M202610".
model DocumentCounter {
  seriesCode String @map("series_code") @db.VarChar(40)
  /// FY2627, M202604 or ALL - plus ":<scope>" for series counted per company (invoices).
  period     String @db.VarChar(40)
  lastNumber Int    @default(0) @map("last_number")

  series DocumentSeries @relation(fields: [seriesCode], references: [code], onDelete: Cascade)

  @@id([seriesCode, period])
  @@map("document_counters")
}

/// Files (drawings, MTC, test reports, signatures). Linked to any record by entity + entityId.
model Attachment {
  id           Int      @id @default(autoincrement())
  entity       String   @db.VarChar(50)
  entityId     Int      @map("entity_id")
  category     String?  @db.VarChar(50)
  originalName String   @map("original_name") @db.VarChar(255)
  storedName   String   @unique @map("stored_name") @db.VarChar(255)
  mimeType     String   @map("mime_type") @db.VarChar(100)
  sizeBytes    Int      @map("size_bytes")
  uploadedById Int?     @map("uploaded_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([entity, entityId])
  @@map("attachments")
}

// =============================================================================
//  MASTERS
// =============================================================================

enum Currency {
  INR
  USD
  EUR
  GBP
  AED
}

model Customer {
  id               Int      @id @default(autoincrement())
  code             String   @unique @db.VarChar(30)
  name             String   @db.VarChar(200)
  contactPerson    String?  @map("contact_person") @db.VarChar(100)
  phone            String?  @db.VarChar(20)
  email            String?  @db.VarChar(150)
  gstin            String?  @db.VarChar(15)
  pan              String?  @db.VarChar(10)
  address          String?  @db.VarChar(500)
  shippingAddress  String?  @map("shipping_address") @db.VarChar(500)
  city             String?  @db.VarChar(100)
  stateCode        String?  @map("state_code") @db.Char(2)
  pincode          String?  @db.VarChar(10)
  country          String   @default("India") @db.VarChar(60)
  currency         Currency @default(INR)
  paymentTermsDays Int?     @map("payment_terms_days")
  notes            String?  @db.Text
  isActive         Boolean  @default(true) @map("is_active")
  createdById      Int?     @map("created_by_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  salesOrders SalesOrder[]
  invoices    Invoice[]
  payments    Payment[]

  @@index([name])
  @@map("customers")
}

enum SupplierType {
  MATERIAL
  JOB_WORK
  SERVICE
  OTHER
}

model Supplier {
  id               Int          @id @default(autoincrement())
  code             String       @unique @db.VarChar(30)
  name             String       @db.VarChar(200)
  type             SupplierType @default(MATERIAL)
  contactPerson    String?      @map("contact_person") @db.VarChar(100)
  phone            String?      @db.VarChar(20)
  email            String?      @db.VarChar(150)
  gstin            String?      @db.VarChar(15)
  pan              String?      @db.VarChar(10)
  address          String?      @db.VarChar(500)
  city             String?      @db.VarChar(100)
  stateCode        String?      @map("state_code") @db.Char(2)
  pincode          String?      @db.VarChar(10)
  country          String       @default("India") @db.VarChar(60)
  paymentTermsDays Int?         @map("payment_terms_days")
  bankName         String?      @map("bank_name") @db.VarChar(100)
  bankAccountNo    String?      @map("bank_account_no") @db.VarChar(30)
  bankIfsc         String?      @map("bank_ifsc") @db.VarChar(15)
  notes            String?      @db.Text
  isActive         Boolean      @default(true) @map("is_active")
  createdById      Int?         @map("created_by_id")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  heats          Heat[]
  purchaseOrders PurchaseOrder[]
  goodsReceipts  GoodsReceipt[]
  jobWorkOrders  JobWorkOrder[]
  payments       Payment[]

  @@index([name])
  @@map("suppliers")
}

/// e.g. HAMMER UNION
model ProductCategory {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(100)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("product_categories")
}

/// MALE, FEMALE, NUT ...
model PartType {
  id               Int      @id @default(autoincrement())
  name             String   @unique @db.VarChar(50)
  hasEndConnection Boolean  @default(true) @map("has_end_connection")
  sortOrder        Int      @default(0) @map("sort_order")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  components ProductComponent[]
  items      Item[]

  @@map("part_types")
}

/// The sellable assembly, e.g. 2" FIG 100 Hammer Union.
model Product {
  id             Int      @id @default(autoincrement())
  code           String   @unique @db.VarChar(30)
  name           String   @unique @db.VarChar(150)
  categoryId     Int      @map("category_id")
  size           String?  @db.VarChar(30)
  figure         String?  @db.VarChar(50)
  pressureRating String?  @map("pressure_rating") @db.VarChar(50)
  hsnCode        String?  @map("hsn_code") @db.VarChar(10)
  description    String?  @db.Text
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  category        ProductCategory    @relation(fields: [categoryId], references: [id])
  components      ProductComponent[]
  items           Item[]
  salesOrderLines SalesOrderLine[]

  @@index([categoryId])
  @@map("products")
}

/// Bill of materials: which parts (and how many) make one set of a product.
model ProductComponent {
  id         Int     @id @default(autoincrement())
  productId  Int     @map("product_id")
  partTypeId Int     @map("part_type_id")
  quantity   Decimal @default(1) @db.Decimal(10, 3)

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  partType PartType @relation(fields: [partTypeId], references: [id])

  @@unique([productId, partTypeId])
  @@index([partTypeId])
  @@map("product_components")
}

enum EndConnection {
  BW
  THD
  NONE
}

enum Unit {
  PCS
  SET
  KG
  MTR
  NOS
}

/// A stockable finished part, e.g. 2" FIG 100 - MALE - BW.
model Item {
  id               Int           @id @default(autoincrement())
  code             String        @unique @db.VarChar(30)
  name             String        @db.VarChar(200)
  productId        Int           @map("product_id")
  partTypeId       Int           @map("part_type_id")
  endConnection    EndConnection @default(NONE) @map("end_connection")
  materialGradeId  Int?          @map("material_grade_id")
  rawMaterialId    Int?          @map("raw_material_id")
  drawingNo        String?       @map("drawing_no") @db.VarChar(50)
  finishedWeightKg Decimal?      @map("finished_weight_kg") @db.Decimal(14, 3)
  inputWeightKg    Decimal?      @map("input_weight_kg") @db.Decimal(14, 3)
  uom              Unit          @default(PCS)
  minPrice         Decimal?      @map("min_price") @db.Decimal(14, 2)
  hsnCode          String?       @map("hsn_code") @db.VarChar(10)
  description      String?       @db.VarChar(500)
  isActive         Boolean       @default(true) @map("is_active")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  product       Product        @relation(fields: [productId], references: [id])
  partType      PartType       @relation(fields: [partTypeId], references: [id])
  materialGrade MaterialGrade? @relation(fields: [materialGradeId], references: [id])
  rawMaterial   RawMaterial?   @relation(fields: [rawMaterialId], references: [id])

  tools               Tool[]
  stockLedger         StockLedger[]
  stockBalances       StockBalance[]
  productionRequests  ProductionRequest[]
  routeCards          RouteCard[]
  jobWorkLines        JobWorkOrderLine[]
  jobWorkReceiptLines JobWorkReceiptLine[]
  purchaseOrderLines  PurchaseOrderLine[]
  assemblyParts       AssemblyConsumption[]
  invoiceLines        InvoiceLine[]

  @@unique([productId, partTypeId, endConnection])
  @@index([partTypeId])
  @@index([materialGradeId])
  @@index([rawMaterialId])
  @@map("items")
}

/// A105, 4130, SS304, F316 ...
model MaterialGrade {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(50)
  /// Letter(s) that start the heat numbers of this grade, e.g. "A" -> A122502
  heatCode    String?  @map("heat_code") @db.VarChar(5)
  standard    String?  @db.VarChar(100)
  description String?  @db.VarChar(255)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rawMaterials    RawMaterial[]
  items           Item[]
  salesOrderLines SalesOrderLine[]

  @@map("material_grades")
}

enum MaterialShape {
  ROUND
  SQUARE
  HEX
  FLAT
  PLATE
  PIPE
  OTHER
}

/// Bar stock identified by grade + size, e.g. A105 / 60 MM ROUND.
model RawMaterial {
  id           Int           @id @default(autoincrement())
  code         String        @unique @db.VarChar(30)
  gradeId      Int           @map("grade_id")
  shape        MaterialShape @default(ROUND)
  size         String        @db.VarChar(100)
  sizeMm       Decimal?      @map("size_mm") @db.Decimal(10, 2)
  densityKgM3  Decimal?      @map("density_kg_m3") @db.Decimal(10, 2)
  uom          Unit          @default(KG)
  reorderLevel Decimal?      @map("reorder_level") @db.Decimal(14, 3)
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  grade                MaterialGrade         @relation(fields: [gradeId], references: [id])
  heats                Heat[]
  items                Item[]
  stockLedger          StockLedger[]
  stockBalances        StockBalance[]
  purchaseRequisitions PurchaseRequisition[]
  purchaseOrderLines   PurchaseOrderLine[]
  goodsReceiptLines    GoodsReceiptLine[]
  routeCards           RouteCard[]
  materialRequisitions MaterialRequisition[]
  materialIssues       MaterialIssue[]
  jobWorkMaterials     JobWorkMaterial[]

  @@unique([gradeId, size])
  @@map("raw_materials")
}

enum HeatStatus {
  ACTIVE
  BLOCKED
  CONSUMED
}

/// A heat (melt lot) of raw material. The heat number follows the
/// material from gate entry to dispatch - the base of all traceability.
model Heat {
  id            Int        @id @default(autoincrement())
  heatNo        String     @unique @map("heat_no") @db.VarChar(50)
  millHeatNo    String?    @map("mill_heat_no") @db.VarChar(100)
  rawMaterialId Int        @map("raw_material_id")
  supplierId    Int?       @map("supplier_id")
  receivedDate  DateTime?  @map("received_date") @db.Date
  status        HeatStatus @default(ACTIVE)
  remarks       String?    @db.VarChar(500)
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  rawMaterial         RawMaterial           @relation(fields: [rawMaterialId], references: [id])
  supplier            Supplier?             @relation(fields: [supplierId], references: [id])
  goodsReceiptLines   GoodsReceiptLine[]
  stockLedger         StockLedger[]
  stockBalances       StockBalance[]
  materialIssues      MaterialIssue[]
  rcCompletionHeats   RcCompletionHeat[]
  jobWorkReceiptLines JobWorkReceiptLine[]
  assemblyParts       AssemblyConsumption[]

  @@index([rawMaterialId])
  @@index([supplierId])
  @@index([millHeatNo])
  @@map("heats")
}

enum StageType {
  TEST
  INSPECTION
  OPERATION
}

/// Production / inspection stages in default order:
/// Chemical test -> RM inspection -> UT -> Cutting -> Forging -> ... -> PDI
model ProcessStage {
  id              Int       @id @default(autoincrement())
  code            String    @unique @db.VarChar(50)
  name            String    @db.VarChar(100)
  sequence        Int
  type            StageType @default(OPERATION)
  captureWeights  Boolean   @default(false) @map("capture_weights")
  requiresReport  Boolean   @default(false) @map("requires_report")
  /// Checks the raw material before cutting (chemical test, RM inspection, UT):
  /// recorded as OK / not OK for the issued heats, without a piece count.
  isMaterialCheck Boolean   @default(false) @map("is_material_check")
  description     String?   @db.VarChar(255)
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  roles             ProcessStageRole[]
  operations        RouteCardOperation[]
  routeCardsWaiting RouteCard[]          @relation("RouteCardCurrentStage")

  @@index([sequence])
  @@map("process_stages")
}

/// Which roles may record a stage (e.g. only "Forging" records the forging stage).
model ProcessStageRole {
  stageId Int @map("stage_id")
  roleId  Int @map("role_id")

  stage ProcessStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  role  Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([stageId, roleId])
  @@index([roleId])
  @@map("process_stage_roles")
}

enum ToolType {
  DIE
  TOOL
  FIXTURE
  GAUGE
}

enum ToolStatus {
  ACTIVE
  INACTIVE
  UNDER_MAINTENANCE
  SCRAPPED
}

model Tool {
  id           Int        @id @default(autoincrement())
  code         String     @unique @db.VarChar(30)
  name         String     @db.VarChar(200)
  type         ToolType   @default(DIE)
  itemId       Int?       @map("item_id")
  location     String?    @db.VarChar(100)
  purchaseDate DateTime?  @map("purchase_date") @db.Date
  lifeShots    Int?       @map("life_shots")
  status       ToolStatus @default(ACTIVE)
  description  String?    @db.VarChar(500)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  item Item? @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@index([itemId])
  @@map("tools")
}

// =============================================================================
//  INVENTORY: one ledger for raw material and finished goods
// =============================================================================

enum StockKind {
  RAW_MATERIAL
  FINISHED_GOOD
}

enum StockLocation {
  RM_STORE
  FG_STORE
  WIP
  JOB_WORK
  REJECTION
}

enum StockRefType {
  OPENING
  GRN
  MATERIAL_ISSUE
  ISSUE_RETURN
  RC_COMPLETION
  JOB_WORK_ISSUE
  JOB_WORK_RECEIPT
  ASSEMBLY
  DISPATCH
  ADJUSTMENT
}

/// Every stock movement, append-only. Balances are derived from this.
model StockLedger {
  id            Int           @id @default(autoincrement())
  date          DateTime      @db.Date
  kind          StockKind
  rawMaterialId Int?          @map("raw_material_id")
  itemId        Int?          @map("item_id")
  heatId        Int?          @map("heat_id")
  location      StockLocation
  qtyIn         Decimal       @default(0) @map("qty_in") @db.Decimal(14, 3)
  qtyOut        Decimal       @default(0) @map("qty_out") @db.Decimal(14, 3)
  refType       StockRefType  @map("ref_type")
  refId         Int?          @map("ref_id")
  refNo         String?       @map("ref_no") @db.VarChar(50)
  remarks       String?       @db.VarChar(500)
  createdById   Int?          @map("created_by_id")
  createdAt     DateTime      @default(now()) @map("created_at")

  rawMaterial RawMaterial? @relation(fields: [rawMaterialId], references: [id])
  item        Item?        @relation(fields: [itemId], references: [id])
  heat        Heat?        @relation(fields: [heatId], references: [id])

  @@index([kind, rawMaterialId])
  @@index([kind, itemId])
  @@index([heatId])
  @@index([refType, refId])
  @@index([date])
  @@map("stock_ledger")
}

/// Current quantity per material/item + heat + location, kept in step with the ledger.
model StockBalance {
  id            Int           @id @default(autoincrement())
  /// "RM:<rawMaterialId>:<heatId|0>:<location>" or "FG:<itemId>:<heatId|0>:<location>"
  balanceKey    String        @unique @map("balance_key") @db.VarChar(80)
  kind          StockKind
  rawMaterialId Int?          @map("raw_material_id")
  itemId        Int?          @map("item_id")
  heatId        Int?          @map("heat_id")
  location      StockLocation
  quantity      Decimal       @default(0) @db.Decimal(14, 3)
  reservedQty   Decimal       @default(0) @map("reserved_qty") @db.Decimal(14, 3)
  updatedAt     DateTime      @updatedAt @map("updated_at")

  rawMaterial RawMaterial? @relation(fields: [rawMaterialId], references: [id])
  item        Item?        @relation(fields: [itemId], references: [id])
  heat        Heat?        @relation(fields: [heatId], references: [id])

  @@index([rawMaterialId])
  @@index([itemId])
  @@index([heatId])
  @@map("stock_balances")
}

// =============================================================================
//  SALES
// =============================================================================

enum SalesOrderStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  IN_PRODUCTION
  PARTIALLY_DISPATCHED
  DISPATCHED
  CLOSED
  CANCELLED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ApprovalStage {
  FEASIBILITY
  DESIGN
  PRODUCTION
}

enum ServiceType {
  STD
  SOUR
}

enum ProductionDecision {
  PENDING
  INHOUSE
  OUTSOURCE
  FROM_STOCK
}

model SalesOrder {
  id                    Int              @id @default(autoincrement())
  soNo                  String           @unique @map("so_no") @db.VarChar(30)
  soDate                DateTime         @map("so_date") @db.Date
  customerId            Int              @map("customer_id")
  customerPoNo          String?          @map("customer_po_no") @db.VarChar(100)
  customerPoDate        DateTime?        @map("customer_po_date") @db.Date
  currency              Currency         @default(INR)
  exchangeRate          Decimal          @default(1) @map("exchange_rate") @db.Decimal(12, 4)
  expectedDelivery      DateTime?        @map("expected_delivery") @db.Date
  salesPersonId         Int?             @map("sales_person_id")
  additionalRequirement String?          @map("additional_requirement") @db.Text
  notes                 String?          @db.Text
  status                SalesOrderStatus @default(DRAFT)
  feasibilityStatus     ApprovalStatus   @default(PENDING) @map("feasibility_status")
  designStatus          ApprovalStatus   @default(PENDING) @map("design_status")
  productionStatus      ApprovalStatus   @default(PENDING) @map("production_status")
  totalAmount           Decimal          @default(0) @map("total_amount") @db.Decimal(14, 2)
  submittedAt           DateTime?        @map("submitted_at")
  approvedAt            DateTime?        @map("approved_at")
  cancelReason          String?          @map("cancel_reason") @db.VarChar(255)
  createdById           Int?             @map("created_by_id")
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")

  customer      Customer             @relation(fields: [customerId], references: [id])
  salesPerson   User?                @relation("SalesPerson", fields: [salesPersonId], references: [id])
  lines         SalesOrderLine[]
  approvals     SalesOrderApproval[]
  jobWorkOrders JobWorkOrder[]
  assemblies    Assembly[]
  invoices      Invoice[]
  dispatches    Dispatch[]

  @@unique([customerId, customerPoNo])
  @@index([salesPersonId])
  @@index([status])
  @@index([soDate])
  @@map("sales_orders")
}

model SalesOrderLine {
  id              Int                @id @default(autoincrement())
  salesOrderId    Int                @map("sales_order_id")
  lineNo          Int                @map("line_no")
  productId       Int                @map("product_id")
  endConnection   EndConnection      @default(NONE) @map("end_connection")
  service         ServiceType        @default(STD)
  schedule        String?            @db.VarChar(30)
  materialGradeId Int?               @map("material_grade_id")
  quantity        Decimal            @db.Decimal(14, 3)
  rate            Decimal            @default(0) @db.Decimal(14, 2)
  amount          Decimal            @default(0) @db.Decimal(14, 2)
  decision        ProductionDecision @default(PENDING)
  dispatchedQty   Decimal            @default(0) @map("dispatched_qty") @db.Decimal(14, 3)
  remarks         String?            @db.VarChar(500)

  salesOrder         SalesOrder          @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product            Product             @relation(fields: [productId], references: [id])
  materialGrade      MaterialGrade?      @relation(fields: [materialGradeId], references: [id])
  productionRequests ProductionRequest[]
  routeCards         RouteCard[]
  jobWorkLines       JobWorkOrderLine[]
  assemblyLines      AssemblyLine[]
  dispatchLines      DispatchLine[]
  invoiceLines       InvoiceLine[]

  @@unique([salesOrderId, lineNo])
  @@index([productId])
  @@index([materialGradeId])
  @@map("sales_order_lines")
}

model SalesOrderApproval {
  id           Int            @id @default(autoincrement())
  salesOrderId Int            @map("sales_order_id")
  stage        ApprovalStage
  decision     ApprovalStatus
  remarks      String?        @db.VarChar(500)
  userId       Int            @map("user_id")
  createdAt    DateTime       @default(now()) @map("created_at")

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id])

  @@index([salesOrderId])
  @@index([userId])
  @@map("sales_order_approvals")
}

// =============================================================================
//  PRODUCTION
// =============================================================================

enum ProductionRequestType {
  MAKE_TO_ORDER
  MAKE_TO_STOCK
}

enum ProductionRequestStatus {
  REQUESTED
  ACCEPTED
  REJECTED
  CANCELLED
  /// Its route card is finished and the parts are in the FG store.
  COMPLETED
}

/// Shortage found at stock check (or a make-to-stock request) asking production to make parts.
model ProductionRequest {
  id               Int                     @id @default(autoincrement())
  requestNo        String                  @unique @map("request_no") @db.VarChar(30)
  type             ProductionRequestType   @default(MAKE_TO_ORDER)
  salesOrderLineId Int?                    @map("sales_order_line_id")
  itemId           Int                     @map("item_id")
  quantity         Decimal                 @db.Decimal(14, 3)
  status           ProductionRequestStatus @default(REQUESTED)
  requiredBy       DateTime?               @map("required_by") @db.Date
  remarks          String?                 @db.VarChar(500)
  cancelReason     String?                 @map("cancel_reason") @db.VarChar(255)
  createdById      Int?                    @map("created_by_id")
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")

  salesOrderLine SalesOrderLine? @relation(fields: [salesOrderLineId], references: [id])
  item           Item            @relation(fields: [itemId], references: [id])
  routeCards     RouteCard[]

  @@index([salesOrderLineId])
  @@index([itemId])
  @@index([status])
  @@map("production_requests")
}

enum RouteCardStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CLOSED
  CANCELLED
}

model RouteCard {
  id                  Int             @id @default(autoincrement())
  rcNo                String          @unique @map("rc_no") @db.VarChar(30)
  rcDate              DateTime        @map("rc_date") @db.Date
  productionRequestId Int?            @map("production_request_id")
  salesOrderLineId    Int?            @map("sales_order_line_id")
  itemId              Int             @map("item_id")
  rawMaterialId       Int?            @map("raw_material_id")
  /// Bar weight needed per piece (kg), to work out how much material to ask for.
  inputWeightKg       Decimal?        @map("input_weight_kg") @db.Decimal(14, 3)
  plannedQty          Decimal         @map("planned_qty") @db.Decimal(14, 3)
  extraQty            Decimal         @default(0) @map("extra_qty") @db.Decimal(14, 3)
  completedQty        Decimal         @default(0) @map("completed_qty") @db.Decimal(14, 3)
  rejectedQty         Decimal         @default(0) @map("rejected_qty") @db.Decimal(14, 3)
  expectedDelivery    DateTime?       @map("expected_delivery") @db.Date
  status              RouteCardStatus @default(OPEN)
  /// Stage currently waiting for work (denormalised for fast lists).
  currentStageId      Int?            @map("current_stage_id")
  remarks             String?         @db.Text
  cancelReason        String?         @map("cancel_reason") @db.VarChar(255)
  createdById         Int?            @map("created_by_id")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  productionRequest    ProductionRequest?    @relation(fields: [productionRequestId], references: [id])
  salesOrderLine       SalesOrderLine?       @relation(fields: [salesOrderLineId], references: [id])
  item                 Item                  @relation(fields: [itemId], references: [id])
  rawMaterial          RawMaterial?          @relation(fields: [rawMaterialId], references: [id])
  currentStage         ProcessStage?         @relation("RouteCardCurrentStage", fields: [currentStageId], references: [id], onDelete: SetNull)
  createdBy            User?                 @relation("RouteCardCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  operations           RouteCardOperation[]
  materialRequisitions MaterialRequisition[]
  materialIssues       MaterialIssue[]
  completions          RcCompletion[]

  @@index([productionRequestId])
  @@index([salesOrderLineId])
  @@index([itemId])
  @@index([rawMaterialId])
  @@index([status])
  @@index([currentStageId])
  @@index([createdById])
  @@map("route_cards")
}

enum OperationStatus {
  PENDING
  IN_PROGRESS
  DONE
  SKIPPED
}

/// One row per stage of a route card (replaces the old processes_json blob).
model RouteCardOperation {
  id              Int             @id @default(autoincrement())
  routeCardId     Int             @map("route_card_id")
  stageId         Int             @map("stage_id")
  sequence        Int
  status          OperationStatus @default(PENDING)
  receivedQty     Decimal?        @map("received_qty") @db.Decimal(14, 3)
  okQty           Decimal?        @map("ok_qty") @db.Decimal(14, 3)
  rejectedQty     Decimal?        @map("rejected_qty") @db.Decimal(14, 3)
  reworkQty       Decimal?        @map("rework_qty") @db.Decimal(14, 3)
  rejectionReason String?         @map("rejection_reason") @db.VarChar(500)
  inputWeightKg   Decimal?        @map("input_weight_kg") @db.Decimal(14, 3)
  outputWeightKg  Decimal?        @map("output_weight_kg") @db.Decimal(14, 3)
  scrapWeightKg   Decimal?        @map("scrap_weight_kg") @db.Decimal(14, 3)
  operatorName    String?         @map("operator_name") @db.VarChar(100)
  machine         String?         @db.VarChar(100)
  /// Stage-specific readings (hardness values, chemistry %, UT result ...).
  readings        Json?
  remarks         String?         @db.VarChar(500)
  startedAt       DateTime?       @map("started_at")
  completedAt     DateTime?       @map("completed_at")
  updatedById     Int?            @map("updated_by_id")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  routeCard RouteCard    @relation(fields: [routeCardId], references: [id], onDelete: Cascade)
  stage     ProcessStage @relation(fields: [stageId], references: [id])
  updatedBy User?        @relation(fields: [updatedById], references: [id])

  @@unique([routeCardId, stageId])
  @@index([stageId, status])
  @@index([updatedById])
  @@map("route_card_operations")
}

enum RequisitionStatus {
  PENDING
  PARTIAL
  ISSUED
  CANCELLED
}

/// Production asks the store for raw material against a route card.
model MaterialRequisition {
  id            Int               @id @default(autoincrement())
  mrNo          String            @unique @map("mr_no") @db.VarChar(30)
  mrDate        DateTime          @map("mr_date") @db.Date
  routeCardId   Int               @map("route_card_id")
  rawMaterialId Int               @map("raw_material_id")
  requestedQty  Decimal           @map("requested_qty") @db.Decimal(14, 3)
  issuedQty     Decimal           @default(0) @map("issued_qty") @db.Decimal(14, 3)
  status        RequisitionStatus @default(PENDING)
  remarks       String?           @db.VarChar(500)
  createdById   Int?              @map("created_by_id")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  routeCard            RouteCard             @relation(fields: [routeCardId], references: [id])
  rawMaterial          RawMaterial           @relation(fields: [rawMaterialId], references: [id])
  createdBy            User?                 @relation("MaterialRequestedBy", fields: [createdById], references: [id], onDelete: SetNull)
  issues               MaterialIssue[]
  purchaseRequisitions PurchaseRequisition[]

  @@index([routeCardId])
  @@index([rawMaterialId])
  @@index([status])
  @@index([createdById])
  @@map("material_requisitions")
}

/// Raw material issued from the store, always against a specific heat.
model MaterialIssue {
  id                    Int      @id @default(autoincrement())
  issueDate             DateTime @map("issue_date") @db.Date
  materialRequisitionId Int?     @map("material_requisition_id")
  routeCardId           Int?     @map("route_card_id")
  jobWorkMaterialId     Int?     @map("job_work_material_id")
  rawMaterialId         Int      @map("raw_material_id")
  heatId                Int      @map("heat_id")
  quantity              Decimal  @db.Decimal(14, 3)
  remarks               String?  @db.VarChar(500)
  issuedById            Int      @map("issued_by_id")
  createdAt             DateTime @default(now()) @map("created_at")

  materialRequisition MaterialRequisition? @relation(fields: [materialRequisitionId], references: [id])
  routeCard           RouteCard?           @relation(fields: [routeCardId], references: [id])
  jobWorkMaterial     JobWorkMaterial?     @relation(fields: [jobWorkMaterialId], references: [id])
  rawMaterial         RawMaterial          @relation(fields: [rawMaterialId], references: [id])
  heat                Heat                 @relation(fields: [heatId], references: [id])
  issuedBy            User                 @relation(fields: [issuedById], references: [id])

  @@index([materialRequisitionId])
  @@index([routeCardId])
  @@index([jobWorkMaterialId])
  @@index([rawMaterialId])
  @@index([heatId])
  @@index([issuedById])
  @@map("material_issues")
}

enum CompletionStatus {
  PENDING
  MOVED_TO_STOCK
}

/// Final-stage OK quantity of a route card, waiting for / moved into FG stock.
model RcCompletion {
  id          Int              @id @default(autoincrement())
  slipNo      String           @unique @map("slip_no") @db.VarChar(30)
  routeCardId Int              @map("route_card_id")
  okQty       Decimal          @map("ok_qty") @db.Decimal(14, 3)
  status      CompletionStatus @default(PENDING)
  movedAt     DateTime?        @map("moved_at")
  movedById   Int?             @map("moved_by_id")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  routeCard RouteCard          @relation(fields: [routeCardId], references: [id])
  movedBy   User?              @relation(fields: [movedById], references: [id])
  heats     RcCompletionHeat[]

  @@index([routeCardId])
  @@index([status])
  @@index([movedById])
  @@map("rc_completions")
}

/// How the moved quantity splits over the heats issued to the route card.
model RcCompletionHeat {
  id           Int     @id @default(autoincrement())
  completionId Int     @map("completion_id")
  heatId       Int     @map("heat_id")
  quantity     Decimal @db.Decimal(14, 3)

  completion RcCompletion @relation(fields: [completionId], references: [id], onDelete: Cascade)
  heat       Heat         @relation(fields: [heatId], references: [id])

  @@unique([completionId, heatId])
  @@index([heatId])
  @@map("rc_completion_heats")
}

// =============================================================================
//  PURCHASE & INCOMING QC
// =============================================================================

enum PurchaseRequisitionStatus {
  PENDING
  ORDERED
  CANCELLED
}

enum PurchaseRequisitionSource {
  MANUAL
  MATERIAL_REQUISITION
  JOB_WORK
  REORDER
}

model PurchaseRequisition {
  id                    Int                       @id @default(autoincrement())
  prNo                  String                    @unique @map("pr_no") @db.VarChar(30)
  prDate                DateTime                  @map("pr_date") @db.Date
  rawMaterialId         Int                       @map("raw_material_id")
  quantity              Decimal                   @db.Decimal(14, 3)
  requiredBy            DateTime?                 @map("required_by") @db.Date
  source                PurchaseRequisitionSource @default(MANUAL)
  materialRequisitionId Int?                      @map("material_requisition_id")
  jobWorkOrderId        Int?                      @map("job_work_order_id")
  status                PurchaseRequisitionStatus @default(PENDING)
  remarks               String?                   @db.VarChar(500)
  createdById           Int?                      @map("created_by_id")
  createdAt             DateTime                  @default(now()) @map("created_at")
  updatedAt             DateTime                  @updatedAt @map("updated_at")

  rawMaterial         RawMaterial          @relation(fields: [rawMaterialId], references: [id])
  materialRequisition MaterialRequisition? @relation(fields: [materialRequisitionId], references: [id])
  jobWorkOrder        JobWorkOrder?        @relation(fields: [jobWorkOrderId], references: [id])
  purchaseOrderLines  PurchaseOrderLine[]

  @@index([rawMaterialId])
  @@index([materialRequisitionId])
  @@index([jobWorkOrderId])
  @@index([status])
  @@map("purchase_requisitions")
}

enum PurchaseOrderType {
  MATERIAL
  JOB_WORK
}

enum PurchaseOrderStatus {
  DRAFT
  ISSUED
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum GstType {
  INTRA_STATE
  INTER_STATE
  EXPORT
  EXEMPT
}

model PurchaseOrder {
  id               Int                 @id @default(autoincrement())
  poNo             String              @unique @map("po_no") @db.VarChar(30)
  poDate           DateTime            @map("po_date") @db.Date
  companyId        Int                 @map("company_id")
  type             PurchaseOrderType   @default(MATERIAL)
  supplierId       Int                 @map("supplier_id")
  jobWorkOrderId   Int?                @map("job_work_order_id")
  quotationRef     String?             @map("quotation_ref") @db.VarChar(100)
  deliveryAddress  String?             @map("delivery_address") @db.VarChar(500)
  paymentTerms     String?             @map("payment_terms") @db.VarChar(255)
  expectedDelivery DateTime?           @map("expected_delivery") @db.Date
  currency         Currency            @default(INR)
  gstType          GstType             @default(INTRA_STATE) @map("gst_type")
  subTotal         Decimal             @default(0) @map("sub_total") @db.Decimal(14, 2)
  discountPercent  Decimal             @default(0) @map("discount_percent") @db.Decimal(5, 2)
  discountAmount   Decimal             @default(0) @map("discount_amount") @db.Decimal(14, 2)
  taxableAmount    Decimal             @default(0) @map("taxable_amount") @db.Decimal(14, 2)
  taxRate          Decimal             @default(18) @map("tax_rate") @db.Decimal(5, 2)
  taxAmount        Decimal             @default(0) @map("tax_amount") @db.Decimal(14, 2)
  freight          Decimal             @default(0) @db.Decimal(14, 2)
  roundOff         Decimal             @default(0) @map("round_off") @db.Decimal(14, 2)
  grandTotal       Decimal             @default(0) @map("grand_total") @db.Decimal(14, 2)
  paidAmount       Decimal             @default(0) @map("paid_amount") @db.Decimal(14, 2)
  paymentStatus    PaymentStatus       @default(UNPAID) @map("payment_status")
  status           PurchaseOrderStatus @default(DRAFT)
  terms            String?             @db.Text
  notes            String?             @db.Text
  approvedById     Int?                @map("approved_by_id")
  approvedAt       DateTime?           @map("approved_at")
  emailedAt        DateTime?           @map("emailed_at")
  cancelReason     String?             @map("cancel_reason") @db.VarChar(255)
  createdById      Int?                @map("created_by_id")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  company       Company             @relation(fields: [companyId], references: [id])
  supplier      Supplier            @relation(fields: [supplierId], references: [id])
  jobWorkOrder  JobWorkOrder?       @relation(fields: [jobWorkOrderId], references: [id])
  lines         PurchaseOrderLine[]
  goodsReceipts GoodsReceipt[]
  payments      Payment[]

  @@index([companyId])
  @@index([supplierId])
  @@index([jobWorkOrderId])
  @@index([status])
  @@index([poDate])
  @@map("purchase_orders")
}

/// Material PO lines use rawMaterialId; job-work PO lines use itemId.
model PurchaseOrderLine {
  id                    Int     @id @default(autoincrement())
  purchaseOrderId       Int     @map("purchase_order_id")
  lineNo                Int     @map("line_no")
  rawMaterialId         Int?    @map("raw_material_id")
  itemId                Int?    @map("item_id")
  purchaseRequisitionId Int?    @map("purchase_requisition_id")
  description           String? @db.VarChar(500)
  quantity              Decimal @db.Decimal(14, 3)
  uom                   Unit    @default(KG)
  rate                  Decimal @db.Decimal(14, 2)
  amount                Decimal @db.Decimal(14, 2)
  receivedQty           Decimal @default(0) @map("received_qty") @db.Decimal(14, 3)

  purchaseOrder       PurchaseOrder        @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  rawMaterial         RawMaterial?         @relation(fields: [rawMaterialId], references: [id])
  item                Item?                @relation(fields: [itemId], references: [id])
  purchaseRequisition PurchaseRequisition? @relation(fields: [purchaseRequisitionId], references: [id])
  goodsReceiptLines   GoodsReceiptLine[]

  @@unique([purchaseOrderId, lineNo])
  @@index([rawMaterialId])
  @@index([itemId])
  @@index([purchaseRequisitionId])
  @@map("purchase_order_lines")
}

enum GoodsReceiptStatus {
  PENDING_QC
  COMPLETED
}

enum QcStatus {
  PENDING
  ACCEPTED
  PARTIAL
  REJECTED
}

/// Gate entry of material arriving at the factory.
model GoodsReceipt {
  id              Int                @id @default(autoincrement())
  grnNo           String             @unique @map("grn_no") @db.VarChar(30)
  grnDate         DateTime           @map("grn_date") @db.Date
  supplierId      Int                @map("supplier_id")
  purchaseOrderId Int?               @map("purchase_order_id")
  supplierChallan String?            @map("supplier_challan") @db.VarChar(50)
  supplierInvoice String?            @map("supplier_invoice") @db.VarChar(50)
  vehicleNo       String?            @map("vehicle_no") @db.VarChar(20)
  status          GoodsReceiptStatus @default(PENDING_QC)
  remarks         String?            @db.VarChar(500)
  createdById     Int?               @map("created_by_id")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  supplier      Supplier           @relation(fields: [supplierId], references: [id])
  purchaseOrder PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id])
  lines         GoodsReceiptLine[]

  @@index([supplierId])
  @@index([purchaseOrderId])
  @@index([status])
  @@map("goods_receipts")
}

/// One received material line + its incoming QC. A heat is created on acceptance.
model GoodsReceiptLine {
  id                  Int       @id @default(autoincrement())
  goodsReceiptId      Int       @map("goods_receipt_id")
  purchaseOrderLineId Int?      @map("purchase_order_line_id")
  rawMaterialId       Int       @map("raw_material_id")
  millHeatNo          String?   @map("mill_heat_no") @db.VarChar(100)
  heatId              Int?      @map("heat_id")
  receivedQty         Decimal   @map("received_qty") @db.Decimal(14, 3)
  acceptedQty         Decimal   @default(0) @map("accepted_qty") @db.Decimal(14, 3)
  rejectedQty         Decimal   @default(0) @map("rejected_qty") @db.Decimal(14, 3)
  qcStatus            QcStatus  @default(PENDING) @map("qc_status")
  qcRemarks           String?   @map("qc_remarks") @db.VarChar(500)
  inspectedById       Int?      @map("inspected_by_id")
  inspectedAt         DateTime? @map("inspected_at")

  goodsReceipt      GoodsReceipt       @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderLine PurchaseOrderLine? @relation(fields: [purchaseOrderLineId], references: [id])
  rawMaterial       RawMaterial        @relation(fields: [rawMaterialId], references: [id])
  heat              Heat?              @relation(fields: [heatId], references: [id])

  @@index([goodsReceiptId])
  @@index([purchaseOrderLineId])
  @@index([rawMaterialId])
  @@index([heatId])
  @@map("goods_receipt_lines")
}

// =============================================================================
//  JOB WORK (OUTSOURCE)
// =============================================================================

enum JobWorkStatus {
  OPEN
  MATERIAL_ISSUED
  PARTIALLY_RECEIVED
  COMPLETED
  CANCELLED
}

/// Parts made by an outside vendor (job worker), usually from our raw material.
model JobWorkOrder {
  id           Int           @id @default(autoincrement())
  jwoNo        String        @unique @map("jwo_no") @db.VarChar(30)
  jwoDate      DateTime      @map("jwo_date") @db.Date
  supplierId   Int           @map("supplier_id")
  salesOrderId Int?          @map("sales_order_id")
  challanNo    String?       @map("challan_no") @db.VarChar(50)
  expectedDate DateTime?     @map("expected_date") @db.Date
  status       JobWorkStatus @default(OPEN)
  remarks      String?       @db.Text
  /// Why it was cancelled or closed short.
  cancelReason String?       @map("cancel_reason") @db.VarChar(255)
  closedAt     DateTime?     @map("closed_at")
  createdById  Int?          @map("created_by_id")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  supplier             Supplier              @relation(fields: [supplierId], references: [id])
  salesOrder           SalesOrder?           @relation(fields: [salesOrderId], references: [id])
  createdBy            User?                 @relation("JobWorkCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  lines                JobWorkOrderLine[]
  materials            JobWorkMaterial[]
  receipts             JobWorkReceipt[]
  purchaseOrders       PurchaseOrder[]
  purchaseRequisitions PurchaseRequisition[]

  @@index([supplierId])
  @@index([salesOrderId])
  @@index([status])
  @@index([createdById])
  @@map("job_work_orders")
}

model JobWorkOrderLine {
  id               Int     @id @default(autoincrement())
  jobWorkOrderId   Int     @map("job_work_order_id")
  itemId           Int     @map("item_id")
  /// The outsourced sales order line this part is for (empty = for stock).
  salesOrderLineId Int?    @map("sales_order_line_id")
  quantity         Decimal @db.Decimal(14, 3)
  /// Accepted at our QC so far.
  receivedQty      Decimal @default(0) @map("received_qty") @db.Decimal(14, 3)
  /// Rejected at our QC so far (the vendor must make them again).
  rejectedQty      Decimal @default(0) @map("rejected_qty") @db.Decimal(14, 3)
  rate             Decimal @default(0) @db.Decimal(14, 2)
  remarks          String? @db.VarChar(500)

  jobWorkOrder   JobWorkOrder         @relation(fields: [jobWorkOrderId], references: [id], onDelete: Cascade)
  item           Item                 @relation(fields: [itemId], references: [id])
  salesOrderLine SalesOrderLine?      @relation(fields: [salesOrderLineId], references: [id])
  receiptLines   JobWorkReceiptLine[]

  @@index([jobWorkOrderId])
  @@index([itemId])
  @@index([salesOrderLineId])
  @@map("job_work_order_lines")
}

/// Raw material to send to the job-work vendor.
model JobWorkMaterial {
  id             Int               @id @default(autoincrement())
  jobWorkOrderId Int               @map("job_work_order_id")
  rawMaterialId  Int               @map("raw_material_id")
  quantity       Decimal           @db.Decimal(14, 3)
  issuedQty      Decimal           @default(0) @map("issued_qty") @db.Decimal(14, 3)
  status         RequisitionStatus @default(PENDING)

  jobWorkOrder JobWorkOrder    @relation(fields: [jobWorkOrderId], references: [id], onDelete: Cascade)
  rawMaterial  RawMaterial     @relation(fields: [rawMaterialId], references: [id])
  issues       MaterialIssue[]

  @@index([jobWorkOrderId])
  @@index([rawMaterialId])
  @@map("job_work_materials")
}

/// Finished parts received back from the vendor, with QC.
model JobWorkReceipt {
  id             Int      @id @default(autoincrement())
  receiptNo      String   @unique @map("receipt_no") @db.VarChar(30)
  receiptDate    DateTime @map("receipt_date") @db.Date
  jobWorkOrderId Int      @map("job_work_order_id")
  vendorChallan  String?  @map("vendor_challan") @db.VarChar(50)
  inspectorName  String?  @map("inspector_name") @db.VarChar(100)
  remarks        String?  @db.VarChar(500)
  createdById    Int?     @map("created_by_id")
  createdAt      DateTime @default(now()) @map("created_at")

  jobWorkOrder JobWorkOrder         @relation(fields: [jobWorkOrderId], references: [id])
  createdBy    User?                @relation("JobWorkReceivedBy", fields: [createdById], references: [id], onDelete: SetNull)
  lines        JobWorkReceiptLine[]

  @@index([jobWorkOrderId])
  @@index([createdById])
  @@map("job_work_receipts")
}

model JobWorkReceiptLine {
  id                 Int     @id @default(autoincrement())
  jobWorkReceiptId   Int     @map("job_work_receipt_id")
  jobWorkOrderLineId Int     @map("job_work_order_line_id")
  itemId             Int     @map("item_id")
  heatId             Int?    @map("heat_id")
  receivedQty        Decimal @map("received_qty") @db.Decimal(14, 3)
  acceptedQty        Decimal @map("accepted_qty") @db.Decimal(14, 3)
  rejectedQty        Decimal @default(0) @map("rejected_qty") @db.Decimal(14, 3)
  /// Rejection reason / QC note.
  remarks            String? @db.VarChar(500)

  jobWorkReceipt   JobWorkReceipt   @relation(fields: [jobWorkReceiptId], references: [id], onDelete: Cascade)
  jobWorkOrderLine JobWorkOrderLine @relation(fields: [jobWorkOrderLineId], references: [id])
  item             Item             @relation(fields: [itemId], references: [id])
  heat             Heat?            @relation(fields: [heatId], references: [id])

  @@index([jobWorkReceiptId])
  @@index([jobWorkOrderLineId])
  @@index([itemId])
  @@index([heatId])
  @@map("job_work_receipt_lines")
}

// =============================================================================
//  ASSEMBLY, INVOICE, DISPATCH, PAYMENTS
// =============================================================================

enum AssemblyStatus {
  PACKED
  INVOICED
  DISPATCHED
  CANCELLED
}

/// Assembling MALE + FEMALE + NUT into sets and packing them for an order.
model Assembly {
  id            Int            @id @default(autoincrement())
  assemblyNo    String         @unique @map("assembly_no") @db.VarChar(30)
  assemblyDate  DateTime       @map("assembly_date") @db.Date
  salesOrderId  Int            @map("sales_order_id")
  packingType   String?        @map("packing_type") @db.VarChar(50)
  packedBy      String?        @map("packed_by") @db.VarChar(100)
  packages      Int?
  grossWeightKg Decimal?       @map("gross_weight_kg") @db.Decimal(14, 3)
  status        AssemblyStatus @default(PACKED)
  remarks       String?        @db.VarChar(500)
  cancelReason  String?        @map("cancel_reason") @db.VarChar(255)
  createdById   Int?           @map("created_by_id")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  salesOrder   SalesOrder            @relation(fields: [salesOrderId], references: [id])
  createdBy    User?                 @relation("AssemblyCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  lines        AssemblyLine[]
  consumptions AssemblyConsumption[]
  invoices     Invoice[]

  @@index([salesOrderId])
  @@index([status])
  @@index([createdById])
  @@map("assemblies")
}

model AssemblyLine {
  id               Int     @id @default(autoincrement())
  assemblyId       Int     @map("assembly_id")
  salesOrderLineId Int     @map("sales_order_line_id")
  quantity         Decimal @db.Decimal(14, 3)

  assembly       Assembly       @relation(fields: [assemblyId], references: [id], onDelete: Cascade)
  salesOrderLine SalesOrderLine @relation(fields: [salesOrderLineId], references: [id])

  @@index([assemblyId])
  @@index([salesOrderLineId])
  @@map("assembly_lines")
}

/// Finished parts (with heat) taken out of FG stock for an assembly.
model AssemblyConsumption {
  id         Int     @id @default(autoincrement())
  assemblyId Int     @map("assembly_id")
  itemId     Int     @map("item_id")
  heatId     Int?    @map("heat_id")
  quantity   Decimal @db.Decimal(14, 3)

  assembly Assembly @relation(fields: [assemblyId], references: [id], onDelete: Cascade)
  item     Item     @relation(fields: [itemId], references: [id])
  heat     Heat?    @relation(fields: [heatId], references: [id])

  @@index([assemblyId])
  @@index([itemId])
  @@index([heatId])
  @@map("assembly_consumptions")
}

enum InvoiceType {
  TAX_INVOICE
  EXPORT_INVOICE
  PROFORMA
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  CANCELLED
}

model Invoice {
  id              Int           @id @default(autoincrement())
  invoiceNo       String        @unique @map("invoice_no") @db.VarChar(30)
  type            InvoiceType   @default(TAX_INVOICE)
  invoiceDate     DateTime      @map("invoice_date") @db.Date
  dueDate         DateTime?     @map("due_date") @db.Date
  companyId       Int           @map("company_id")
  customerId      Int           @map("customer_id")
  salesOrderId    Int?          @map("sales_order_id")
  assemblyId      Int?          @map("assembly_id")
  currency        Currency      @default(INR)
  exchangeRate    Decimal       @default(1) @map("exchange_rate") @db.Decimal(12, 4)
  /// Party details are copied at invoice time - an issued invoice must not change.
  billingName     String        @map("billing_name") @db.VarChar(200)
  billingAddress  String?       @map("billing_address") @db.VarChar(500)
  billingGstin    String?       @map("billing_gstin") @db.VarChar(15)
  shippingName    String?       @map("shipping_name") @db.VarChar(200)
  shippingAddress String?       @map("shipping_address") @db.VarChar(500)
  shippingGstin   String?       @map("shipping_gstin") @db.VarChar(15)
  placeOfSupply   String?       @map("place_of_supply") @db.Char(2)
  gstType         GstType       @default(INTRA_STATE) @map("gst_type")
  /// GST % for all lines (18 for hammer unions).
  taxRate         Decimal       @default(18) @map("tax_rate") @db.Decimal(5, 2)
  discountPercent Decimal       @default(0) @map("discount_percent") @db.Decimal(5, 2)
  customerPoNo    String?       @map("customer_po_no") @db.VarChar(100)
  customerPoDate  DateTime?     @map("customer_po_date") @db.Date
  transporter     String?       @db.VarChar(100)
  vehicleNo       String?       @map("vehicle_no") @db.VarChar(20)
  subTotal        Decimal       @default(0) @map("sub_total") @db.Decimal(14, 2)
  discountAmount  Decimal       @default(0) @map("discount_amount") @db.Decimal(14, 2)
  taxableAmount   Decimal       @default(0) @map("taxable_amount") @db.Decimal(14, 2)
  cgstAmount      Decimal       @default(0) @map("cgst_amount") @db.Decimal(14, 2)
  sgstAmount      Decimal       @default(0) @map("sgst_amount") @db.Decimal(14, 2)
  igstAmount      Decimal       @default(0) @map("igst_amount") @db.Decimal(14, 2)
  freight         Decimal       @default(0) @db.Decimal(14, 2)
  roundOff        Decimal       @default(0) @map("round_off") @db.Decimal(14, 2)
  grandTotal      Decimal       @default(0) @map("grand_total") @db.Decimal(14, 2)
  amountPaid      Decimal       @default(0) @map("amount_paid") @db.Decimal(14, 2)
  paymentStatus   PaymentStatus @default(UNPAID) @map("payment_status")
  status          InvoiceStatus @default(DRAFT)
  terms           String?       @db.Text
  notes           String?       @db.Text
  issuedAt        DateTime?     @map("issued_at")
  emailedAt       DateTime?     @map("emailed_at")
  cancelReason    String?       @map("cancel_reason") @db.VarChar(255)
  createdById     Int?          @map("created_by_id")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  company    Company       @relation(fields: [companyId], references: [id])
  customer   Customer      @relation(fields: [customerId], references: [id])
  salesOrder SalesOrder?   @relation(fields: [salesOrderId], references: [id])
  assembly   Assembly?     @relation(fields: [assemblyId], references: [id])
  createdBy  User?         @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  lines      InvoiceLine[]
  dispatches Dispatch[]
  payments   Payment[]

  @@index([companyId])
  @@index([customerId])
  @@index([salesOrderId])
  @@index([assemblyId])
  @@index([invoiceDate])
  @@index([status])
  @@index([createdById])
  @@map("invoices")
}

model InvoiceLine {
  id               Int     @id @default(autoincrement())
  invoiceId        Int     @map("invoice_id")
  lineNo           Int     @map("line_no")
  /// The sales order line billed (sets); dispatch follows it.
  salesOrderLineId Int?    @map("sales_order_line_id")
  itemId           Int?    @map("item_id")
  description      String  @db.VarChar(500)
  hsnCode          String? @map("hsn_code") @db.VarChar(10)
  quantity         Decimal @db.Decimal(14, 3)
  uom              Unit    @default(SET)
  rate             Decimal @db.Decimal(14, 2)
  taxRate          Decimal @default(18) @map("tax_rate") @db.Decimal(5, 2)
  amount           Decimal @db.Decimal(14, 2)

  invoice        Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  item           Item?           @relation(fields: [itemId], references: [id])
  salesOrderLine SalesOrderLine? @relation(fields: [salesOrderLineId], references: [id])

  @@unique([invoiceId, lineNo])
  @@index([itemId])
  @@index([salesOrderLineId])
  @@map("invoice_lines")
}

model Dispatch {
  id            Int       @id @default(autoincrement())
  dispatchNo    String    @unique @map("dispatch_no") @db.VarChar(30)
  dispatchDate  DateTime  @map("dispatch_date") @db.Date
  salesOrderId  Int       @map("sales_order_id")
  invoiceId     Int?      @map("invoice_id")
  challanNo     String?   @map("challan_no") @db.VarChar(50)
  transporter   String?   @db.VarChar(100)
  lrNo          String?   @map("lr_no") @db.VarChar(50)
  vehicleNo     String?   @map("vehicle_no") @db.VarChar(20)
  driverName    String?   @map("driver_name") @db.VarChar(100)
  driverPhone   String?   @map("driver_phone") @db.VarChar(20)
  loadedBy      String?   @map("loaded_by") @db.VarChar(100)
  packages      Int?
  grossWeightKg Decimal?  @map("gross_weight_kg") @db.Decimal(14, 3)
  remarks       String?   @db.VarChar(500)
  cancelledAt   DateTime? @map("cancelled_at")
  cancelReason  String?   @map("cancel_reason") @db.VarChar(255)
  createdById   Int?      @map("created_by_id")
  createdAt     DateTime  @default(now()) @map("created_at")

  salesOrder SalesOrder     @relation(fields: [salesOrderId], references: [id])
  invoice    Invoice?       @relation(fields: [invoiceId], references: [id])
  createdBy  User?          @relation("DispatchCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  lines      DispatchLine[]

  @@index([salesOrderId])
  @@index([invoiceId])
  @@index([dispatchDate])
  @@index([createdById])
  @@map("dispatches")
}

model DispatchLine {
  id               Int     @id @default(autoincrement())
  dispatchId       Int     @map("dispatch_id")
  salesOrderLineId Int     @map("sales_order_line_id")
  quantity         Decimal @db.Decimal(14, 3)

  dispatch       Dispatch       @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  salesOrderLine SalesOrderLine @relation(fields: [salesOrderLineId], references: [id])

  @@index([dispatchId])
  @@index([salesOrderLineId])
  @@map("dispatch_lines")
}

enum PaymentDirection {
  RECEIPT
  PAYMENT
}

enum PaymentMode {
  CASH
  BANK_TRANSFER
  UPI
  CHEQUE
  OTHER
}

/// Money received from customers or paid to suppliers.
model Payment {
  id              Int              @id @default(autoincrement())
  paymentNo       String           @unique @map("payment_no") @db.VarChar(30)
  paymentDate     DateTime         @map("payment_date") @db.Date
  direction       PaymentDirection
  customerId      Int?             @map("customer_id")
  supplierId      Int?             @map("supplier_id")
  invoiceId       Int?             @map("invoice_id")
  purchaseOrderId Int?             @map("purchase_order_id")
  amount          Decimal          @db.Decimal(14, 2)
  mode            PaymentMode      @default(BANK_TRANSFER)
  reference       String?          @db.VarChar(100)
  remarks         String?          @db.VarChar(500)
  cancelledAt     DateTime?        @map("cancelled_at")
  cancelReason    String?          @map("cancel_reason") @db.VarChar(255)
  createdById     Int?             @map("created_by_id")
  createdAt       DateTime         @default(now()) @map("created_at")

  customer      Customer?      @relation(fields: [customerId], references: [id])
  supplier      Supplier?      @relation(fields: [supplierId], references: [id])
  invoice       Invoice?       @relation(fields: [invoiceId], references: [id])
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  createdBy     User?          @relation("PaymentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([supplierId])
  @@index([invoiceId])
  @@index([purchaseOrderId])
  @@index([paymentDate])
  @@index([createdById])
  @@map("payments")
}

// =============================================================================
//  HR & PAYROLL
// =============================================================================

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum EmployeeStatus {
  ACTIVE
  LEFT
}

model Department {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")

  employees Employee[]

  @@map("departments")
}

model Employee {
  id            Int            @id @default(autoincrement())
  empCode       String         @unique @map("emp_code") @db.VarChar(30)
  name          String         @db.VarChar(100)
  gender        Gender         @default(MALE)
  dateOfBirth   DateTime?      @map("date_of_birth") @db.Date
  dateOfJoining DateTime?      @map("date_of_joining") @db.Date
  departmentId  Int?           @map("department_id")
  designation   String?        @db.VarChar(100)
  phone         String?        @db.VarChar(20)
  email         String?        @db.VarChar(150)
  address       String?        @db.VarChar(500)
  basicSalary   Decimal        @default(0) @map("basic_salary") @db.Decimal(12, 2)
  ctc           Decimal?       @db.Decimal(12, 2)
  shiftHours    Decimal        @default(8) @map("shift_hours") @db.Decimal(4, 2)
  isPfEligible  Boolean        @default(true) @map("is_pf_eligible")
  uan           String?        @db.VarChar(20)
  bankName      String?        @map("bank_name") @db.VarChar(100)
  bankAccountNo String?        @map("bank_account_no") @db.VarChar(30)
  bankIfsc      String?        @map("bank_ifsc") @db.VarChar(15)
  status        EmployeeStatus @default(ACTIVE)
  leftOn        DateTime?      @map("left_on") @db.Date
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  department    Department?       @relation(fields: [departmentId], references: [id])
  attendance    Attendance[]
  leaveBalances LeaveBalance[]
  leaveRequests LeaveRequest[]
  loans         EmployeeLoan[]
  payslips      Payslip[]
  assets        CompanyAsset[]
  punches       AttendancePunch[]

  @@index([departmentId])
  @@map("employees")
}

enum AttendanceSource {
  DEVICE
  MANUAL
  IMPORT
}

model Attendance {
  id            Int              @id @default(autoincrement())
  employeeId    Int              @map("employee_id")
  date          DateTime         @db.Date
  /// Raw punch times from the biometric device, e.g. ["09:01","13:00","13:31","18:05"]
  punches       Json?
  inTime        String?          @map("in_time") @db.VarChar(5)
  outTime       String?          @map("out_time") @db.VarChar(5)
  hoursWorked   Decimal          @default(0) @map("hours_worked") @db.Decimal(5, 2)
  source        AttendanceSource @default(DEVICE)
  importBatchId String?          @map("import_batch_id") @db.VarChar(50)
  remarks       String?          @db.VarChar(255)
  /// Who last corrected the punches by hand (null = machine / import only)
  updatedById   Int?             @map("updated_by_id")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([date])
  @@map("attendance")
}

/// Biometric machine that pushes punches (eSSL / ZKTeco "ADMS" push). Only approved machines are accepted.
model BiometricDevice {
  id          Int       @id @default(autoincrement())
  serialNo    String    @unique @map("serial_no") @db.VarChar(50)
  name        String?   @db.VarChar(100)
  isApproved  Boolean   @default(false) @map("is_approved")
  lastSeenAt  DateTime? @map("last_seen_at")
  lastPunchAt DateTime? @map("last_punch_at")
  lastIp      String?   @map("last_ip") @db.VarChar(64)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("biometric_devices")
}

/// Every punch as it arrived (machine, CSV import or typed in) - the raw record behind the daily attendance.
model AttendancePunch {
  id           Int              @id @default(autoincrement())
  /// Employee code as the machine sends it (its user PIN)
  empCode      String           @map("emp_code") @db.VarChar(50)
  employeeId   Int?             @map("employee_id")
  date         DateTime         @db.Date
  /// "HH:MM:SS", India wall-clock time as shown on the machine
  time         String           @db.VarChar(8)
  source       AttendanceSource @default(DEVICE)
  deviceSerial String?          @map("device_serial") @db.VarChar(50)
  /// false = not counted: the employee code was unknown or the day was already closed by payroll
  applied      Boolean          @default(true)
  createdAt    DateTime         @default(now()) @map("created_at")

  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@unique([empCode, date, time])
  @@index([date])
  @@index([employeeId])
  @@map("attendance_punches")
}

/// Once a date is locked, attendance for it can no longer be changed.
model AttendanceLock {
  date       DateTime @id @db.Date
  lockedAt   DateTime @default(now()) @map("locked_at")
  lockedById Int?     @map("locked_by_id")

  @@map("attendance_locks")
}

enum LeaveType {
  CL
  SL
  EL
  LWP
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveBalance {
  id         Int     @id @default(autoincrement())
  employeeId Int     @map("employee_id")
  year       Int
  casual     Decimal @default(0) @db.Decimal(5, 1)
  sick       Decimal @default(0) @db.Decimal(5, 1)
  earned     Decimal @default(0) @db.Decimal(5, 1)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, year])
  @@map("leave_balances")
}

model LeaveRequest {
  id          Int         @id @default(autoincrement())
  employeeId  Int         @map("employee_id")
  type        LeaveType
  fromDate    DateTime    @map("from_date") @db.Date
  toDate      DateTime    @map("to_date") @db.Date
  isHalfDay   Boolean     @default(false) @map("is_half_day")
  days        Decimal     @db.Decimal(5, 1)
  reason      String      @db.VarChar(500)
  status      LeaveStatus @default(PENDING)
  adminRemark String?     @map("admin_remark") @db.VarChar(500)
  decidedById Int?        @map("decided_by_id")
  decidedAt   DateTime?   @map("decided_at")
  createdById Int?        @map("created_by_id")
  createdAt   DateTime    @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([status])
  @@map("leave_requests")
}

enum LoanType {
  ADVANCE
  PERSONAL_LOAN
}

enum LoanStatus {
  ACTIVE
  PAUSED
  CLOSED
}

model EmployeeLoan {
  id               Int         @id @default(autoincrement())
  employeeId       Int         @map("employee_id")
  type             LoanType    @default(ADVANCE)
  amount           Decimal     @db.Decimal(12, 2)
  emiAmount        Decimal     @map("emi_amount") @db.Decimal(12, 2)
  balance          Decimal     @db.Decimal(12, 2)
  /// "YYYY-MM" - first payroll month in which the EMI is deducted
  startMonth       String      @map("start_month") @db.Char(7)
  disbursementMode PaymentMode @default(BANK_TRANSFER) @map("disbursement_mode")
  disbursementRef  String?     @map("disbursement_ref") @db.VarChar(100)
  reason           String?     @db.VarChar(255)
  status           LoanStatus  @default(ACTIVE)
  createdById      Int?        @map("created_by_id")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  employee   Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  repayments LoanRepayment[]

  @@index([employeeId])
  @@map("employee_loans")
}

model LoanRepayment {
  id          Int          @id @default(autoincrement())
  loanId      Int          @map("loan_id")
  payslipId   Int?         @map("payslip_id")
  date        DateTime     @db.Date
  amount      Decimal      @db.Decimal(12, 2)
  /// How a repayment outside payroll was made (cash, bank ...); null for salary deductions
  mode        PaymentMode? @map("mode")
  remarks     String?      @db.VarChar(255)
  createdById Int?         @map("created_by_id")
  createdAt   DateTime     @default(now()) @map("created_at")

  loan    EmployeeLoan @relation(fields: [loanId], references: [id], onDelete: Cascade)
  payslip Payslip?     @relation(fields: [payslipId], references: [id], onDelete: SetNull)

  @@index([loanId])
  @@index([payslipId])
  @@map("loan_repayments")
}

enum PayrollStatus {
  DRAFT
  FINALIZED
  PAID
}

model PayrollRun {
  id            Int           @id @default(autoincrement())
  /// "YYYY-MM"
  month         String        @unique @db.Char(7)
  monthDays     Int           @map("month_days")
  /// PF % of basic used for this month
  pfPercent     Decimal       @default(12) @map("pf_percent") @db.Decimal(5, 2)
  status        PayrollStatus @default(DRAFT)
  createdById   Int?          @map("created_by_id")
  finalizedAt   DateTime?     @map("finalized_at")
  finalizedById Int?          @map("finalized_by_id")
  paidAt        DateTime?     @map("paid_at")
  paidById      Int?          @map("paid_by_id")
  paymentRef    String?       @map("payment_ref") @db.VarChar(100)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  payslips Payslip[]

  @@map("payroll_runs")
}

model Payslip {
  id              Int     @id @default(autoincrement())
  payrollRunId    Int     @map("payroll_run_id")
  employeeId      Int     @map("employee_id")
  basicSalary     Decimal @map("basic_salary") @db.Decimal(12, 2)
  shiftHours      Decimal @default(8) @map("shift_hours") @db.Decimal(5, 2)
  isPfEligible    Boolean @default(false) @map("is_pf_eligible")
  /// Days with punches (Sundays not counted)
  presentDays     Decimal @map("present_days") @db.Decimal(5, 1)
  /// Approved CL / SL / EL on days without punches
  paidLeaveDays   Decimal @default(0) @map("paid_leave_days") @db.Decimal(5, 1)
  /// present + paid leave, at most the month days
  payableDays     Decimal @default(0) @map("payable_days") @db.Decimal(5, 1)
  absentDays      Decimal @default(0) @map("absent_days") @db.Decimal(5, 1)
  sundaysWorked   Int     @default(0) @map("sundays_worked")
  hoursWorked     Decimal @map("hours_worked") @db.Decimal(7, 2)
  expectedHours   Decimal @default(0) @map("expected_hours") @db.Decimal(7, 2)
  hourDifference  Decimal @default(0) @map("hour_difference") @db.Decimal(7, 2)
  /// Basic / month days x payable days
  baseEarning     Decimal @default(0) @map("base_earning") @db.Decimal(12, 2)
  hourAdjustment  Decimal @default(0) @map("hour_adjustment") @db.Decimal(12, 2)
  grossEarning    Decimal @map("gross_earning") @db.Decimal(12, 2)
  pfDeduction     Decimal @default(0) @map("pf_deduction") @db.Decimal(12, 2)
  loanDeduction   Decimal @default(0) @map("loan_deduction") @db.Decimal(12, 2)
  /// Added by HR (+ bonus / Sunday work, - fine ...), with a note
  otherAdjustment Decimal @default(0) @map("other_adjustment") @db.Decimal(12, 2)
  adjustmentNote  String? @map("adjustment_note") @db.VarChar(255)
  roundOff        Decimal @default(0) @map("round_off") @db.Decimal(12, 2)
  netSalary       Decimal @map("net_salary") @db.Decimal(12, 2)

  payrollRun     PayrollRun      @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee       Employee        @relation(fields: [employeeId], references: [id])
  loanRepayments LoanRepayment[]

  @@unique([payrollRunId, employeeId])
  @@index([employeeId])
  @@map("payslips")
}

model CompanyAsset {
  id           Int       @id @default(autoincrement())
  code         String    @unique @db.VarChar(30)
  name         String    @db.VarChar(200)
  category     String?   @db.VarChar(100)
  department   String?   @db.VarChar(100)
  employeeId   Int?      @map("employee_id")
  status       String    @default("IN_USE") @db.VarChar(30)
  assignDate   DateTime? @map("assign_date") @db.Date
  returnDate   DateTime? @map("return_date") @db.Date
  warrantyDate DateTime? @map("warranty_date") @db.Date
  remarks      String?   @db.VarChar(500)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@map("company_assets")
}

/// Fire extinguishers, first-aid kits ... with inspection due dates.
model SafetyAsset {
  id                     Int       @id @default(autoincrement())
  code                   String    @unique @db.VarChar(30)
  name                   String    @db.VarChar(200)
  locationZone           String?   @map("location_zone") @db.VarChar(150)
  typeCapacity           String?   @map("type_capacity") @db.VarChar(150)
  installationDate       DateTime? @map("installation_date") @db.Date
  lastInspectionDate     DateTime? @map("last_inspection_date") @db.Date
  nextDueDate            DateTime? @map("next_due_date") @db.Date
  lastServiceDate        DateTime? @map("last_service_date") @db.Date
  /// Days between inspections; recording an inspection sets the next due date
  inspectionIntervalDays Int?      @map("inspection_interval_days")
  vendorAgency           String?   @map("vendor_agency") @db.VarChar(200)
  status                 String    @default("OK") @db.VarChar(30)
  remarks                String?   @db.VarChar(500)
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  @@index([nextDueDate])
  @@map("safety_assets")
}
